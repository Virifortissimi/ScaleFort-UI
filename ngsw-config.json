{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/robots.txt",
          "/sitemap.xml",
          "/_redirects"
        ],
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**",
          "https://cdn.jsdelivr.net/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "remote-media",
      "urls": [
        "https://res.cloudinary.com/**",
        "https://images.pexels.com/**",
        "https://www.ebanqo.com/**",
        "https://sterling.ng/**",
        "https://prunedge.com/**"
      ],
      "cacheConfig": {
        "maxSize": 80,
        "maxAge": "7d",
        "timeout": "10s",
        "strategy": "freshness"
      }
    }
  ]
}
